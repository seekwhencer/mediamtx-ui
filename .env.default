SERVER_PORT=3000

MEDIAMTX_VERSION=latest

# MEDIAMTX ports (disabled by default)
HLS_PORT=8888
RTSP_PORT=8554
RTMP_PORT=1935
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
METRICS_PORT=9998

# not needed! the server accessing directly thru the docker network
API_PORT=9997

# HLS-Base-URL für die UI (Theater/Stream-Wall) — wird an den Vite-Build/dev-Server übergeben.
VITE_MEDIAMTX_HLS_URL=http://localhost:8888

# Speicherpfad für die persistierte mediamtx.yml (relativ zum Server-CWD).
# Leer lassen, um das Auto-Speichern auszuschalten.
MEDIAMTX_CONFIG_PATH=../mediamtx/mediamtx.yml
